# Copy this file to .env for local development.
# Never commit the real Turnstile secret.

# Cloudflare's documented always-pass test secret. When this value is used,
# Yabane automatically uses the matching test site key unless overridden below.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# For production, set a matching widget pair and remove the test secret above.
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET=your-turnstile-secret-key

# Comma-separated browser hostnames accepted during verification.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Optional server settings.
# YABANE_ADDR=127.0.0.1:8080
# YABANE_LOG=info
